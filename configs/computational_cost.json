{
  "schema_version": 1,
  "experiment_id": "acr-pinn-computational-cost-v1",
  "result_prefix": "cost_",
  "training_policy": {
    "learning_rate": 0.001,
    "lr_schedule": "linear_warmup_then_cosine",
    "lr_min": 0.0001,
    "warmup_epochs": 100,
    "checkpoint_policy": "fixed_final_iteration"
  },
  "seed_policy": {
    "master_seed_base": 19018,
    "sample_seed_offset": 1000,
    "optimizer_order_seed_offset": 2000,
    "paired_runs": 1
  },
  "cost_protocol": {
    "warmup_steps": 100,
    "timed_steps": 200,
    "repetitions": 3,
    "require_exclusive_gpu": true
  },
  "conditions": {
    "std": {"architecture": "mlp", "optimizer": "sum"},
    "gc": {"architecture": "mlp", "optimizer": "pcgrad"},
    "lda": {"architecture": "lda", "optimizer": "sum"},
    "acr": {"architecture": "lda", "optimizer": "pcgrad"},
    "mlp_param_matched": {"architecture": "mlp_param_matched", "optimizer": "sum"}
  },
  "problems": {
    "helmholtz_1_4": {
      "script": "helmholtz/train.py", "layers": [2, 50, 50, 50, 50, 1], "epochs": 100000, "record_every": 1000,
      "environment": {"HELMHOLTZ_A1": 1.0, "HELMHOLTZ_A2": 4.0, "HELMHOLTZ_K": 1.0, "HELMHOLTZ_NUM_F": 10000, "HELMHOLTZ_NUM_B": 400, "HELMHOLTZ_DYNAMIC_SAMPLING": 1, "HELMHOLTZ_RESAMPLE_EVERY": 1, "COST_BENCHMARK": 1, "COST_WARMUP_STEPS": 100, "COST_TIMED_STEPS": 200}
    },
    "lid_driven_cavity": {
      "script": "lid_driven_cavity/train.py", "layers": [2, 50, 50, 50, 50, 2], "epochs": 100000, "record_every": 1000,
      "environment": {"CAVITY_NUM_F": 1000, "CAVITY_NUM_TOP": 300, "CAVITY_NUM_WALL": 300, "CAVITY_DYNAMIC_SAMPLING": 1, "CAVITY_RESAMPLE_EVERY": 1, "CAVITY_GENERATED_DATA_DIR": "generated_data/cost_extended/lid_driven_cavity", "NO_PLOT": 1, "COST_BENCHMARK": 1, "COST_WARMUP_STEPS": 100, "COST_TIMED_STEPS": 200}
    },
    "poisson_5d": {
      "script": "poisson_5d/train.py", "layers": [5, 50, 50, 50, 50, 1], "epochs": 100000, "record_every": 1000,
      "environment": {"POISSON_5D_DIMENSION": 5, "POISSON_5D_NUM_F": 20000, "POISSON_5D_NUM_B": 5000, "POISSON_5D_NUM_TEST": 100000, "POISSON_5D_RESAMPLE_EVERY": 1, "POISSON_5D_GENERATED_DATA_DIR": "generated_data/cost_extended/poisson_5d", "COST_BENCHMARK": 1, "COST_WARMUP_STEPS": 100, "COST_TIMED_STEPS": 200}
    },
    "schrodinger": {
      "script": "schrodinger/train.py", "layers": [2, 50, 50, 50, 50, 2], "epochs": 100000, "record_every": 1000,
      "environment": {"SCHRODINGER_NUM_F": 20000, "SCHRODINGER_NUM_B": 500, "SCHRODINGER_NUM_IC": 500, "SCHRODINGER_RESAMPLE_EVERY": 1, "SCHRODINGER_GENERATED_DATA_DIR": "generated_data/cost_extended/schrodinger", "NO_PLOT": 1, "COST_BENCHMARK": 1, "COST_WARMUP_STEPS": 100, "COST_TIMED_STEPS": 200}
    }
  }
}
