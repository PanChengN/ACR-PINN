{
  "schema_version": 1,
  "experiment_id": "acr-pinn-optimizer-comparison-v1",
  "result_prefix": "optimizer_",
  "training_policy": {
    "learning_rate": 0.001,
    "lr_schedule": "linear_warmup_then_cosine",
    "lr_min": 0.0001,
    "warmup_epochs": 100,
    "checkpoint_policy": "fixed_final_iteration"
  },
  "seed_policy": {
    "master_seed_base": 19018,
    "init_seed_offset": 0,
    "sample_seed_offset": 1000,
    "optimizer_order_seed_offset": 2000,
    "paired_runs": 5
  },
  "architectures": ["mlp"],
  "optimizer_strategies": ["sum", "pcgrad", "mgda", "gradnorm", "ntk"],
  "optimizer_hyperparameters": {
    "gradnorm_alpha": 1.5,
    "gradnorm_learning_rate": 0.025,
    "ntk_update_every": 100,
    "ntk_max_outputs": 128
  },
  "problems": {
    "burgers": {
      "script": "burgers/train.py",
      "layers": [2, 50, 50, 50, 50, 1],
      "epochs": 40000,
      "record_every": 300,
      "environment": {
        "BURGERS_NUM_F": 20000,
        "BURGERS_NUM_B": 500,
        "BURGERS_NUM_IC": 500,
        "BURGERS_DYNAMIC_SAMPLING": 1,
        "BURGERS_BOUNDARY_COUNT_IS_TOTAL": 1,
        "BURGERS_RESAMPLE_EVERY": 1,
        "WARMUP_EPOCHS": 100,
        "GRADNORM_ALPHA": 1.5,
        "GRADNORM_LR": 0.025,
        "NTK_UPDATE_EVERY": 100,
        "NTK_MAX_OUTPUTS": 128
      }
    },
    "helmholtz_4_4": {
      "script": "helmholtz/train.py",
      "layers": [2, 50, 50, 50, 50, 1],
      "epochs": 100000,
      "record_every": 1000,
      "environment": {
        "HELMHOLTZ_A1": 4.0,
        "HELMHOLTZ_A2": 4.0,
        "HELMHOLTZ_K": 1.0,
        "HELMHOLTZ_NUM_F": 20000,
        "HELMHOLTZ_NUM_B": 400,
        "HELMHOLTZ_DYNAMIC_SAMPLING": 1,
        "HELMHOLTZ_RESAMPLE_EVERY": 1,
        "WARMUP_EPOCHS": 100,
        "GRADNORM_ALPHA": 1.5,
        "GRADNORM_LR": 0.025,
        "NTK_UPDATE_EVERY": 100,
        "NTK_MAX_OUTPUTS": 128
      }
    }
  }
}
