{
  "schema_version": 1,
  "experiment_id": "acr-pinn-poisson-5d-v1",
  "result_prefix": "core_",
  "training_policy": {
    "learning_rate": 0.001,
    "lr_schedule": "linear_warmup_then_cosine",
    "lr_min": 0.0001,
    "warmup_epochs": 100,
    "checkpoint_policy": "fixed_final_iteration"
  },
  "seed_policy": {
    "master_seed_base": 19018,
    "init_seed_offset": 0,
    "sample_seed_offset": 1000,
    "optimizer_order_seed_offset": 2000,
    "paired_runs": 5
  },
  "architectures": ["mlp", "lda"],
  "optimizer_strategies": ["sum", "pcgrad"],
  "problems": {
    "poisson_5d": {
      "script": "poisson_5d/train.py",
      "layers": [5, 50, 50, 50, 50, 1],
      "epochs": 100000,
      "record_every": 1000,
      "environment": {
        "POISSON_5D_DIMENSION": 5,
        "POISSON_5D_NUM_F": 20000,
        "POISSON_5D_NUM_B": 5000,
        "POISSON_5D_NUM_TEST": 100000,
        "POISSON_5D_RESAMPLE_EVERY": 1,
        "WARMUP_EPOCHS": 100
      },
      "samples": {"residual": 20000, "boundary": 5000}
    }
  }
}
