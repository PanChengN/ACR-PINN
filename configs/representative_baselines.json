{
  "schema_version": 1,
  "experiment_id": "acr-pinn-representative-baselines-v1",
  "result_prefix": "baseline_",
  "training_policy": {
    "learning_rate": 0.001,
    "lr_schedule": "linear_warmup_then_cosine",
    "lr_min": 0.0001,
    "warmup_epochs": 100,
    "checkpoint_policy": "fixed_final_iteration",
    "sampling_policy": "fixed_training_points"
  },
  "seed_policy": {
    "master_seed_base": 19018,
    "init_seed_offset": 0,
    "sample_seed_offset": 1000,
    "optimizer_order_seed_offset": 2000,
    "paired_runs": 5
  },
  "baseline_conditions": [
    "mlp_sum",
    "modified_mlp_sum",
    "modified_mlp_lra",
    "fourier_mlp_sum",
    "mlp_rba",
    "mlp_brdr"
  ],
  "adaptive_hyperparameters": {
    "lra_update_every": 10,
    "lra_ema": 0.9,
    "rba_eta": 0.001,
    "rba_gamma": 0.999,
    "brdr_beta_c": 0.999,
    "brdr_beta_w": 0.999
  },
  "fourier_selection": {
    "feature_count": 50,
    "candidate_scales": [1.0, 5.0],
    "selection_protocol": "preliminary_average_rank_across_selected_pdes",
    "formal_scale": 1.0,
    "status": "selected_by_preliminary_scale_comparison"
  },
  "problems": {
    "burgers": {
      "script": "burgers/train.py",
      "layers": [2, 50, 50, 50, 50, 1],
      "epochs": 40000,
      "record_every": 300,
      "environment": {
        "BURGERS_NUM_F": 20000,
        "BURGERS_NUM_B": 500,
        "BURGERS_NUM_IC": 500,
        "BURGERS_DYNAMIC_SAMPLING": 0,
        "BURGERS_BOUNDARY_COUNT_IS_TOTAL": 1,
        "WARMUP_EPOCHS": 100,
        "LRA_UPDATE_EVERY": 10,
        "LRA_EMA": 0.9,
        "RBA_ETA": 0.001,
        "RBA_GAMMA": 0.999,
        "BRDR_BETA_C": 0.999,
        "BRDR_BETA_W": 0.999
        ,"FOURIER_SCALE": 1.0
      }
    },
    "helmholtz_4_4": {
      "script": "helmholtz/train.py",
      "layers": [2, 50, 50, 50, 50, 1],
      "epochs": 100000,
      "record_every": 1000,
      "environment": {
        "HELMHOLTZ_A1": 4.0,
        "HELMHOLTZ_A2": 4.0,
        "HELMHOLTZ_K": 1.0,
        "HELMHOLTZ_NUM_F": 20000,
        "HELMHOLTZ_NUM_B": 400,
        "HELMHOLTZ_DYNAMIC_SAMPLING": 0,
        "WARMUP_EPOCHS": 100,
        "LRA_UPDATE_EVERY": 10,
        "LRA_EMA": 0.9,
        "RBA_ETA": 0.001,
        "RBA_GAMMA": 0.999,
        "BRDR_BETA_C": 0.999,
        "BRDR_BETA_W": 0.999
        ,"FOURIER_SCALE": 1.0
      }
    },
    "klein_gordon": {
      "script": "klein_gordon/train.py",
      "layers": [2, 50, 50, 50, 50, 1],
      "epochs": 100000,
      "record_every": 1000,
      "environment": {
        "KLEIN_GORDON_NUM_F": 10000,
        "KLEIN_GORDON_NUM_B": 200,
        "KLEIN_GORDON_NUM_IC": 200,
        "KLEIN_GORDON_DYNAMIC_SAMPLING": 0,
        "WARMUP_EPOCHS": 100,
        "LRA_UPDATE_EVERY": 10,
        "LRA_EMA": 0.9,
        "RBA_ETA": 0.001,
        "RBA_GAMMA": 0.999,
        "BRDR_BETA_C": 0.999,
        "BRDR_BETA_W": 0.999
      }
    }
  }
}
