{
  "schema_version": 1,
  "experiment_id": "acr-pinn-spatiotemporal-v1",
  "result_prefix": "spatiotemporal_",
  "training_policy": {
    "learning_rate": 0.001,
    "lr_schedule": "linear_warmup_then_cosine",
    "lr_min": 0.0001,
    "warmup_epochs": 100,
    "checkpoint_policy": "fixed_final_iteration"
  },
  "seed_policy": {
    "master_seed_base": 19018,
    "init_seed_offset": 0,
    "sample_seed_offset": 1000,
    "optimizer_order_seed_offset": 2000,
    "paired_runs": 5
  },
  "architectures": ["lda", "separate_st_lda"],
  "optimizer_strategies": ["sum", "pcgrad"],
  "problems": {
    "klein_gordon_t1": {
      "script": "klein_gordon/train.py",
      "layers": [2, 50, 50, 50, 50, 1],
      "epochs": 100000,
      "record_every": 1000,
      "environment": {
        "KLEIN_GORDON_TIME_MAX": 1.0,
        "KLEIN_GORDON_NUM_F": 10000,
        "KLEIN_GORDON_NUM_B": 200,
        "KLEIN_GORDON_NUM_IC": 200,
        "KLEIN_GORDON_DYNAMIC_SAMPLING": 1,
        "KLEIN_GORDON_RESAMPLE_EVERY": 1,
        "WARMUP_EPOCHS": 100
      },
      "samples": {"residual": 10000, "boundary": 200, "initial": 200}
    },
    "klein_gordon_t2": {
      "script": "klein_gordon/train.py",
      "layers": [2, 50, 50, 50, 50, 1],
      "epochs": 100000,
      "record_every": 1000,
      "environment": {
        "KLEIN_GORDON_TIME_MAX": 2.0,
        "KLEIN_GORDON_NUM_F": 10000,
        "KLEIN_GORDON_NUM_B": 200,
        "KLEIN_GORDON_NUM_IC": 200,
        "KLEIN_GORDON_DYNAMIC_SAMPLING": 1,
        "KLEIN_GORDON_RESAMPLE_EVERY": 1,
        "WARMUP_EPOCHS": 100
      },
      "samples": {"residual": 10000, "boundary": 200, "initial": 200}
    },
    "klein_gordon_t4": {
      "script": "klein_gordon/train.py",
      "layers": [2, 50, 50, 50, 50, 1],
      "epochs": 100000,
      "record_every": 1000,
      "environment": {
        "KLEIN_GORDON_TIME_MAX": 4.0,
